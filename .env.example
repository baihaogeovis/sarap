# Copy to .env for local development. Never commit real secrets.

SARAP_ENV=dev
SARAP_SECRET_KEY=change-me-dev-only
SARAP_ACCESS_TOKEN_MINUTES=60
SARAP_REFRESH_TOKEN_DAYS=7
SARAP_DATABASE_URL=postgresql+psycopg://sarap:sarap@localhost:5432/sarap
SARAP_CORS_ORIGINS=http://localhost:5173
SARAP_SEED_ON_STARTUP=true

# Internal token shared by the platform API and the engine control plane
SARAP_INTERNAL_TOKEN=dev-internal-token
SARAP_ENGINE_URL=http://localhost:8081
SARAP_ENGINE_TOKEN=dev-internal-token

# Engine
SARAP_ENGINE_MODE=mock
SARAP_ENGINE_HOST=0.0.0.0
SARAP_ENGINE_PORT=8081
SARAP_ENGINE_REDIS_URL=redis://localhost:6379/0
SARAP_ENGINE_WORK_DIR=./data/engine-work
SARAP_ENGINE_PLATFORM_INGEST_URL=http://localhost:8000/api/v1/internal/products
# Analysis CRS is per-pilot (see docs/specs). Example in the demo seed: EPSG:4548.
# AOI geography uses EPSG:4490. Do not use Web Mercator for analysis.

# Object storage (MinIO / S3)
SARAP_S3_ENDPOINT=http://localhost:9000
SARAP_S3_ACCESS_KEY=sarap
SARAP_S3_SECRET_KEY=sarap-dev-secret
SARAP_S3_BUCKET=sarap
SARAP_S3_REGION=us-east-1

# Web
VITE_API_BASE_URL=http://localhost:8000/api/v1
